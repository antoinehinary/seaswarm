# Copy to .env and adjust. Never commit .env.

# Local LLM server used by the operator agent (default model: ollama_chat/qwen3:8b).
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud model instead of Ollama (LiteLLM model id plus that provider's key).
# SEASWARM_MODEL_ID=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional, stretch only: Copernicus Marine account for real surface currents.
# COPERNICUSMARINE_SERVICE_USERNAME=
# COPERNICUSMARINE_SERVICE_PASSWORD=
